// services/imageService.js
const RandomImageGenerator = require('../utils/imageGenerator');
const { v4: uuidv4 } = require('uuid');
const sharp = require('sharp');
const { S3Client, PutObjectCommand } = require('@aws-sdk/client-s3');

class ImageService {
    constructor(db, s3, redis) {
        this.db = db;
        this.s3 = s3;
        this.redis = redis;
    }
    
    // خرید تصویر تصادفی
    async purchaseRandomImage(userId, paymentRef) {
        const client = await this.db.connect();
        
        try {
            await client.query('BEGIN');
            
            // بررسی پرداخت
            const payment = await this.verifyPayment(paymentRef);
            if (!payment || payment.amount < 1.00) {
                throw new Error('پرداخت نامعتبر');
            }
            
            // تولید seed منحصربه‌فرد
            const seed = Date.now() * 1000 + Math.floor(Math.random() * 1000);
            
            // تولید تصویر
            const { buffer, rarity, type } = await RandomImageGenerator.generate(seed);
            
            // تولید کد منحصربه‌فرد
            let uniqueCode;
            let codeExists = true;
            while (codeExists) {
                uniqueCode = RandomImageGenerator.generateUniqueCode();
                const check = await client.query(
                    'SELECT id FROM images WHERE unique_code = $1',
                    [uniqueCode]
                );
                codeExists = check.rows.length > 0;
            }
            
            // آپلود تصویر در S3
            const imageKey = `images/${uniqueCode}.png`;
            await this.s3.send(new PutObjectCommand({
                Bucket: process.env.S3_BUCKET,
                Key: imageKey,
                Body: buffer,
                ContentType: 'image/png'
            }));
            const imageUrl = `${process.env.CDN_URL}/${imageKey}`;
            
            // ذخیره در دیتابیس
            const imageResult = await client.query(`
                INSERT INTO images (unique_code, image_url, image_hash, generation_seed, 
                    generation_params, current_owner_id, original_buyer_id, rarity_level)
                VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
                RETURNING *
            `, [
                uniqueCode, imageUrl,
                require('crypto').createHash('sha256').update(buffer).digest('hex'),
                seed, JSON.stringify({ type, rarity }),
                userId, userId, rarity
            ]);
            
            const image = imageResult.rows[0];
            
            // ثبت تراکنش خرید
            await client.query(`
                INSERT INTO purchases (user_id, image_id, amount, payment_ref, status)
                VALUES ($1, $2, $3, $4, 'completed')
            `, [userId, image.id, 1.00, paymentRef]);
            
            // اضافه کردن به قرعه‌کشی جاری
            await this.addToCurrentLottery(client, userId, image.id, uniqueCode);
            
            // بروزرسانی آمار کاربر
            await client.query(`
                UPDATE users SET total_spent = total_spent + 1.00 WHERE id = $1
            `, [userId]);
            
            // ثبت تراکنش مالی
            await client.query(`
                INSERT INTO transactions (user_id, type, amount, reference_id, reference_type, description)
                VALUES ($1, 'image_purchase', -1.00, $2, 'image', $3)
            `, [userId, image.id, `خرید تصویر تصادفی - کد: ${uniqueCode}`]);
            
            await client.query('COMMIT');
            
            return {
                image: {
                    id: image.id,
                    code: uniqueCode,
                    url: imageUrl,
                    rarity
                },
                lotteryEntry: {
                    code: uniqueCode,
                    drawDate: await this.getNextDrawDate()
                }
            };
            
        } catch (error) {
            await client.query('ROLLBACK');
            throw error;
        } finally {
            client.release();
        }
    }
    
    // اضافه کردن به قرعه‌کشی جاری
    async addToCurrentLottery(client, userId, imageId, code) {
        const currentRound = await client.query(`
            SELECT id FROM lottery_rounds 
            WHERE status = 'active' AND end_date > NOW()
            ORDER BY round_number DESC LIMIT 1
        `);
        
        if (currentRound.rows.length === 0) {
            throw new Error('قرعه‌کشی فعالی وجود ندارد');
        }
        
        await client.query(`
            INSERT INTO lottery_entries (round_id, user_id, image_id, entry_code, contribution_weight)
            VALUES ($1, $2, $3, $4, 1.00)
        `, [currentRound.rows[0].id, userId, imageId, code]);
        
        // بروزرسانی مجموع جایزه
        await client.query(`
            UPDATE lottery_rounds 
            SET total_pool = total_pool + 1.00,
                prize_amount = (total_pool + 1.00) * 0.50
            WHERE id = $1
        `, [currentRound.rows[0].id]);
    }
    
    async getNextDrawDate() {
        const result = await this.db.query(`
            SELECT end_date FROM lottery_rounds 
            WHERE status = 'active' 
            ORDER BY end_date ASC LIMIT 1
        `);
        return result.rows[0]?.end_date;
    }
}

module.exports = ImageService;
