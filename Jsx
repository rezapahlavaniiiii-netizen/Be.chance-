// pages/index.tsx - Next.js
import { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import confetti from 'canvas-confetti';

export default function HomePage() {
    const [isPurchasing, setIsPurchasing] = useState(false);
    const [purchasedImage, setPurchasedImage] = useState(null);
    const [lotteryInfo, setLotteryInfo] = useState(null);
    const [marketplace, setMarketplace] = useState([]);
    const [stats, setStats] = useState({ totalImages: 0, totalPool: 0, nextDraw: null });
    
    useEffect(() => {
        fetchStats();
        fetchMarketplace();
        setupWebSocket();
    }, []);
    
    const fetchStats = async () => {
        const res = await fetch('/api/stats/platform');
        const data = await res.json();
        setStats(data);
    };
    
    const fetchMarketplace = async () => {
        const res = await fetch('/api/marketplace/browse');
        const data = await res.json();
        setMarketplace(data.listings);
    };
    
    const handleRandomPurchase = async () => {
        setIsPurchasing(true);
        
        try {
            const res = await fetch('/api/images/random-buy', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include'
            });
            
            const data = await res.json();
            
            setPurchasedImage(data.image);
            confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
            
        } catch (error) {
            alert('خطا در خرید: ' + error.message);
        } finally {
            setIsPurchasing(false);
        }
    };
    
    return (
        <div className="min-h-screen bg-gradient-to-br from-gray-900 via-purple-900 to-gray-900">
            
            {/* هدر */}
            <header className="border-b border-white/10 backdrop-blur-xl bg-black/30">
                <div className="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
                    <div className="flex items-center gap-3">
                        <div className="w-10 h-10 bg-gradient-to-br from-purple-500 to-pink-500 rounded-xl flex items-center justify-center">
                            🎨
                        </div>
                        <h1 className="text-2xl font-bold text-white">RandomArt</h1>
                    </div>
                    <div className="flex items-center gap-4">
                        <button className="px-4 py-2 text-white/70 hover:text-white transition">
                            بازار
                        </button>
                        <button className="px-4 py-2 text-white/70 hover:text-white transition">
                            قرعه‌کشی
                        </button>
                        <button className="px-6 py-2 bg-gradient-to-r from-purple-500 to-pink-500 text-white rounded-xl font-bold">
                            ورود
                        </button>
                    </div>
                </div>
            </header>
            
            {/* بنر اصلی */}
            <section className="relative overflow-hidden">
                <div className="absolute inset-0">
                    <div className="absolute top-20 left-20 w-72 h-72 bg-purple-500/30 rounded-full blur-3xl animate-pulse" />
                    <div className="absolute bottom-20 right-20 w-96 h-96 bg-pink-500/20 rounded-full blur-3xl animate-pulse delay-1000" />
                </div>
                
                <div className="relative max-w-7xl mx-auto px-4 py-20 text-center">
                    <motion.h2 
                        initial={{ opacity: 0, y: 20 }}
                        animate={{ opacity: 1, y: 0 }}
                        className="text-5xl md:text-7xl font-black text-white mb-6"
                    >
                        یک دلار بده،
                        <br />
                        <span className="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-400">
                            هنر تصادفی بگیر!
                        </span>
                    </motion.h2>
                    
                    <p className="text-xl text-white/70 mb-10 max-w-2xl mx-auto">
                        هر خرید = یک تصویر منحصربه‌فرد + یک شانس قرعه‌کشی
                        <br />
                        ۵۰٪ کل فروش به برنده خوش‌شانس تعلق می‌گیرد!
                    </p>
                    
                    {/* آمار زنده */}
                    <div className="grid grid-cols-3 gap-6 max-w-lg mx-auto mb-12">
                        <div className="bg-white/10 backdrop-blur rounded-2xl p-4">
                            <div className="text-3xl font-bold text-white">{stats.totalImages.toLocaleString()}</div>
                            <div className="text-sm text-white/50">تصویر فروخته شده</div>
                        </div>
                        <div className="bg-white/10 backdrop-blur rounded-2xl p-4">
                            <div className="text-3xl font-bold text-green-400">${stats.totalPool.toLocaleString()}</div>
                            <div className="text-sm text-white/50">مجموع جایزه</div>
                        </div>
                        <div className="bg-white/10 backdrop-blur rounded-2xl p-4">
                            <div className="text-3xl font-bold text-yellow-400">
                                {stats.nextDraw ? new Date(stats.nextDraw).toLocaleDateString('fa-IR') : '---'}
                            </div>
                            <div className="text-sm text-white/50">قرعه‌کشی بعدی</div>
                        </div>
                    </div>
                    
                    {/* دکمه خرید */}
                    <motion.button
                        whileHover={{ scale: 1.05 }}
                        whileTap={{ scale: 0.95 }}
                        onClick={handleRandomPurchase}
                        disabled={isPurchasing}
                        className="relative px-12 py-5 bg-gradient-to-r from-purple-500 via-pink-500 to-orange-500 text-white text-xl font-black rounded-2xl shadow-2xl shadow-purple-500/50 disabled:opacity-50"
                    >
                        {isPurchasing ? (
                            <span className="flex items-center gap-3">
                                <svg className="animate-spin h-6 w-6" viewBox="0 0 24 24">
                                    <circle className="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" strokeWidth="4" fill="none" />
                                    <path className="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                                </svg>
                                در حال تولید تصویر شما...
                            </span>
                        ) : (
                            '🎲 خرید تصویر تصادفی - فقط ۱ دلار'
                        )}
                    </motion.button>
                </div>
            </section>
            
            {/* نمایش تصویر خریداری شده */}
            <AnimatePresence>
                {purchasedImage && (
                    <motion.div
                        initial={{ opacity: 0 }}
                        animate={{ opacity: 1 }}
                        exit={{ opacity: 0 }}
                        className="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur p-4"
                        onClick={() => setPurchasedImage(null)}
                    >
                        <motion.div
                            initial={{ scale: 0.5, rotate: -10 }}
                            animate={{ scale: 1, rotate: 0 }}
                            className="bg-gradient-to-br from-gray-800 to-gray-900 rounded-3xl p-8 max-w-md w-full text-center border border-white/10"
                            onClick={e => e.stopPropagation()}
                        >
                            <div className="text-6xl mb-4">🎉</div>
                            <h3 className="text-2xl font-bold text-white mb-4">تبریک!</h3>
                            
                            <div className="relative group mb-6">
                                <div className="absolute -inset-1 bg-gradient-to-r from-purple-500 to-pink-500 rounded-2xl blur opacity-75 group-hover:opacity-100 transition" />
                                <img 
                                    src={purchasedImage.url} 
                                    alt="تصویر شما"
                                    className="relative rounded-2xl w-full"
                                />
                            </div>
                            
                            <div className="bg-white/10 rounded-xl p-4 mb-4">
                                <div className="text-sm text-white/50 mb-1">کد منحصربه‌فرد شما</div>
                                <div className="text-3xl font-mono font-bold text-yellow-400 tracking-widest">
                                    {purchasedImage.code}
                                </div>
                            </div>
                            
                            <div className={`inline-block px-4 py-2 rounded-full text-sm font-bold mb-4 ${
                                purchasedImage.rarity === 'legendary' ? 'bg-yellow-500/20 text-yellow-400' :
                                purchasedImage.rarity === 'epic' ? 'bg-purple-500/20 text-purple-400' :
                                purchasedImage.rarity === 'rare' ? 'bg-blue-500/20 text-blue-400' :
                                purchasedImage.rarity === 'uncommon' ? 'bg-green-500/20 text-green-400' :
                                'bg-gray-500/20 text-gray-400'
                            }`}>
                                {purchasedImage.rarity === 'legendary' ? '⭐ افسانه‌ای' :
                                 purchasedImage.rarity === 'epic' ? '💜 حماسی' :
                                 purchasedImage.rarity === 'rare' ? '💎 نادر' :
                                 purchasedImage.rarity === 'uncommon' ? '🟢 غیرمعمول' : '⚪ معمولی'}
                            </div>
                            
                            <p className="text-white/50 text-sm">
                                شانس شما در قرعه‌کشی فعال ثبت شد ✅
                            </p>
                        </motion.div>
                    </motion.div>
                )}
            </AnimatePresence>
            
            {/* بازار */}
            <section className="max-w-7xl mx-auto px-4 py-16">
                <h3 className="text-3xl font-bold text-white mb-8 flex items-center gap-3">
                    🏪 بازار تصاویر
                    <span className="text-sm font-normal text-white/50">خرید و فروش بین کاربران</span>
                </h3>
                
                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    {marketplace.slice(0, 8).map((item) => (
                        <motion.div
                            key={item.id}
                            whileHover={{ y: -5 }}
                            className="bg-white/5 backdrop-blur rounded-2xl overflow-hidden border border-white/10 hover:border-purple-500/50 transition-all cursor-pointer"
                        >
                            <img src={item.image_url} alt="" className="w-full aspect-square object-cover" />
                            <div className="p-4">
                                <div className="flex justify-between items-start mb-2">
                                    <span className="font-mono text-sm text-white/70">{item.unique_code}</span>
                                    <span className={`px-2 py-1 rounded-full text-xs font-bold ${
                                        item.rarity_level === 'legendary' ? 'bg-yellow-500/20 text-yellow-400' :
                                        'bg-gray-500/20 text-gray-400'
                                    }`}>
                                        {item.rarity_level}
                                    </span>
                                </div>
                                <div className="flex justify-between items-center">
                                    <span className="text-xl font-bold text-green-400">${item.listing_price}</span>
                                    <button className="px-4 py-2 bg-purple-500 text-white text-sm rounded-lg hover:bg-purple-600 transition">
                                        خرید
                                    </button>
                                </div>
                            </div>
                        </motion.div>
                    ))}
                </div>
            </section>
            
            {/* فوتر */}
            <footer className="border-t border-white/10 bg-black/30">
                <div className="max-w-7xl mx-auto px-4 py-8 text-center text-white/30 text-sm">
                    © 2024 RandomArt - تمامی حقوق محفوظ است
                </div>
            </footer>
        </div>
    );
}
