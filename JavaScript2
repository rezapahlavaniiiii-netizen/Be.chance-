// services/marketplaceService.js
class MarketplaceService {
    constructor(db, redis, io) {
        this.db = db;
        this.redis = redis;
        this.io = io;
    }
    
    // لیست کردن تصویر برای فروش
    async listForSale(userId, imageId, askingPrice, minOffer = null) {
        // بررسی مالکیت
        const image = await this.db.query(
            'SELECT * FROM images WHERE id = $1 AND current_owner_id = $2',
            [imageId, userId]
        );
        
        if (image.rows.length === 0) {
            throw new Error('شما مالک این تصویر نیستید');
        }
        
        const result = await this.db.query(`
            INSERT INTO marketplace_listings (seller_id, image_id, asking_price, min_offer, expires_at)
            VALUES ($1, $2, $3, $4, NOW() + INTERVAL '7 days')
            RETURNING *
        `, [userId, imageId, askingPrice, minOffer || askingPrice * 0.5]);
        
        // بروزرسانی وضعیت تصویر
        await this.db.query(`
            UPDATE images SET is_listed_for_sale = TRUE, listing_price = $1 WHERE id = $2
        `, [askingPrice, imageId]);
        
        // اطلاع‌رسانی real-time
        this.io.emit('new_listing', {
            listing: result.rows[0],
            image: image.rows[0]
        });
        
        return result.rows[0];
    }
    
    // ارسال پیشنهاد خرید
    async makeOffer(buyerId, listingId, amount) {
        const client = await this.db.connect();
        
        try {
            await client.query('BEGIN');
            
            // بررسی لیست
            const listing = await client.query(`
                SELECT ml.*, i.unique_code, i.image_url 
                FROM marketplace_listings ml
                JOIN images i ON ml.image_id = i.id
                WHERE ml.id = $1 AND ml.status = 'active'
            `, [listingId]);
            
            if (listing.rows.length === 0) {
                throw new Error('این لیست دیگر فعال نیست');
            }
            
            const list = listing.rows[0];
            
            // بررسی حداقل پیشنهاد
            if (amount < list.min_offer) {
                throw new Error(`حداقل پیشنهاد ${list.min_offer} دلار است`);
            }
            
            // بررسی موجودی کیف پول
            const buyer = await client.query(
                'SELECT wallet_balance FROM users WHERE id = $1',
                [buyerId]
            );
            
            if (buyer.rows[0].wallet_balance < amount) {
                throw new Error('موجودی کیف پول کافی نیست');
            }
            
            // قفل کردن مبلغ
            await client.query(`
                UPDATE users SET wallet_balance = wallet_balance - $1 WHERE id = $2
            `, [amount, buyerId]);
            
            await client.query(`
                INSERT INTO transactions (user_id, type, amount, reference_id, reference_type, description)
                VALUES ($1, 'offer_lock', -$2, $3, 'offer', 'قفل مبلغ پیشنهاد خرید')
            `, [buyerId, amount, listingId]);
            
            // ثبت پیشنهاد
            const offer = await client.query(`
                INSERT INTO offers (buyer_id, listing_id, offer_amount, status)
                VALUES ($1, $2, $3, 'pending')
                RETURNING *
            `, [buyerId, listingId, amount]);
            
            await client.query('COMMIT');
            
            // اطلاع‌رسانی به فروشنده
            this.io.to(`user_${list.seller_id}`).emit('new_offer', {
                offer: offer.rows[0],
                listing: list
            });
            
            return offer.rows[0];
            
        } catch (error) {
            await client.query('ROLLBACK');
            throw error;
        } finally {
            client.release();
        }
    }
    
    // قبول پیشنهاد و انتقال مالکیت
    async acceptOffer(sellerId, offerId) {
        const client = await this.db.connect();
        
        try {
            await client.query('BEGIN');
            
            // قفل ردیف‌ها
            const offer = await client.query(`
                SELECT o.*, ml.seller_id, ml.image_id, ml.asking_price
                FROM offers o
                JOIN marketplace_listings ml ON o.listing_id = ml.id
                WHERE o.id = $1 AND o.status = 'pending'
                FOR UPDATE
            `, [offerId]);
            
            if (offer.rows.length === 0) {
                throw new Error('پیشنهاد نامعتبر');
            }
            
            const offerData = offer.rows[0];
            
            if (offerData.seller_id !== sellerId) {
                throw new Error('شما فروشنده این تصویر نیستید');
            }
            
            const platformFee = offerData.offer_amount * 0.05; // ۵٪ کارمزد
            const sellerAmount = offerData.offer_amount - platformFee;
            
            // انتقال پول به فروشنده
            await client.query(`
                UPDATE users SET wallet_balance = wallet_balance + $1 WHERE id = $2
            `, [sellerAmount, sellerId]);
            
            // انتقال مالکیت تصویر
            await client.query(`
                UPDATE images 
                SET current_owner_id = $1, 
                    current_value = $2,
                    is_listed_for_sale = FALSE,
                    listing_price = NULL
                WHERE id = $3
            `, [offerData.buyer_id, offerData.offer_amount, offerData.image_id]);
            
            // بروزرسانی قرعه‌کشی - انتقال شانس
            await client.query(`
                UPDATE lottery_entries 
                SET user_id = $1 
                WHERE image_id = $2 AND round_id IN (
                    SELECT id FROM lottery_rounds WHERE status = 'active'
                )
            `, [offerData.buyer_id, offerData.image_id]);
            
            // بستن پیشنهاد و لیست
            await client.query(`UPDATE offers SET status = 'accepted', responded_at = NOW() WHERE id = $1`, [offerId]);
            await client.query(`UPDATE offers SET status = 'cancelled' WHERE listing_id = $1 AND id != $2`, [offerData.listing_id, offerId]);
            await client.query(`UPDATE marketplace_listings SET status = 'sold' WHERE id = $1`, [offerData.listing_id]);
            
            // تراکنش‌ها
            await client.query(`
                INSERT INTO transactions (user_id, type, amount, reference_id, reference_type, description)
                VALUES 
                    ($1, 'sale_income', $2, $3, 'image', 'فروش تصویر'),
                    ($4, 'platform_fee', -$5, $3, 'image', 'کارمزد پلتفرم'),
                    ($6, 'image_purchase', -$7, $3, 'image', 'خرید تصویر از بازار')
            `, [sellerId, sellerAmount, offerData.image_id, sellerId, platformFee, offerData.buyer_id, offerData.offer_amount]);
            
            await client.query('COMMIT');
            
            // اطلاع‌رسانی
            this.io.to(`user_${offerData.buyer_id}`).emit('offer_accepted', { offerId, imageId: offerData.image_id });
            this.io.to(`user_${sellerId}`).emit('image_sold', { offerId, amount: sellerAmount });
            
            return { success: true, sellerAmount, platformFee };
            
        } catch (error) {
            await client.query('ROLLBACK');
            throw error;
        } finally {
            client.release();
        }
    }
    
    // خرید جمعی
    async createPoolBuy(initiatorId, imageId, targetAmount) {
        // بررسی اینکه تصویر لیست شده باشد
        const listing = await this.db.query(`
            SELECT ml.* FROM marketplace_listings ml
            WHERE ml.image_id = $1 AND ml.status = 'active'
        `, [imageId]);
        
        if (listing.rows.length === 0) {
            throw new Error('این تصویر در بازار لیست نشده');
        }
        
        const pool = await this.db.query(`
            INSERT INTO pool_buys (image_id, target_amount, initiator_id, deadline)
            VALUES ($1, $2, $3, NOW() + INTERVAL '48 hours')
            RETURNING *
        `, [imageId, targetAmount, initiatorId]);
        
        return pool.rows[0];
    }
    
    // مشارکت در خرید جمعی
    async contributeToPool(userId, poolId, amount) {
        const client = await this.db.connect();
        
        try {
            await client.query('BEGIN');
            
            const pool = await client.query(`
                SELECT * FROM pool_buys WHERE id = $1 AND status = 'collecting'
                FOR UPDATE
            `, [poolId]);
            
            if (pool.rows.length === 0) {
                throw new Error('خرید جمعی فعال نیست');
            }
            
            const poolData = pool.rows[0];
            
            if (poolData.collected_amount + amount > poolData.target_amount) {
                throw new Error('مبلغ از حد نصاب بیشتر است');
            }
            
            // بررسی موجودی
            const user = await client.query(
                'SELECT wallet_balance FROM users WHERE id = $1',
                [userId]
            );
            
            if (user.rows[0].wallet_balance < amount) {
                throw new Error('موجودی کافی نیست');
            }
            
            // کسر از کیف پول
            await client.query(`
                UPDATE users SET wallet_balance = wallet_balance - $1 WHERE id = $2
            `, [amount, userId]);
            
            const ownershipPct = (amount / poolData.target_amount) * 100;
            
            // ثبت مشارکت
            await client.query(`
                INSERT INTO pool_contributions (pool_buy_id, user_id, amount, ownership_percentage)
                VALUES ($1, $2, $3, $4)
            `, [poolId, userId, amount, ownershipPct]);
            
            // بروزرسانی pool
            const newCollected = parseFloat(poolData.collected_amount) + amount;
            await client.query(`
                UPDATE pool_buys SET collected_amount = $1 WHERE id = $2
            `, [newCollected, poolId]);
            
            await client.query('COMMIT');
            
            return {
                contribution: amount,
                ownershipPercentage: ownershipPct,
                totalCollected: newCollected,
                targetAmount: poolData.target_amount,
                isComplete: newCollected >= poolData.target_amount
            };
            
        } catch (error) {
            await client.query('ROLLBACK');
            throw error;
        } finally {
            client.release();
        }
    }
}

module.exports = MarketplaceService;
